generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    CUSTOMER
    DRIVER
}

model User {
    id           String   @id @default(uuid())
    email        String   @unique
    passwordHash String
    name         String
    role         Role
    createdAt    DateTime @default(now())

    @@map("users")
}
